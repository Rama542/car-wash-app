# YouPI-PG settings for GaadiGlow.
# setup.sh copies this to the gateway folder as .env and fills every __GENERATE__ value
# with a fresh random secret. Then edit the lines marked EDIT.
# Never share or commit the finished .env.

# --- Ports (leave as they are) ---
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
HELP_PORTAL_PORT=3000
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_WALLET_STORE_PORT=5000

# --- Public addresses ---
# In production the gateway builds its addresses from these two values:
#   https://pay.gaadiglow.in        checkout (customers see this inside the app)
#   https://pay-api.gaadiglow.in    payment API (Cloud Functions call it)
#   https://pay-admin.gaadiglow.in  merchant admin (lock it with Cloudflare Access)
#   https://pay-gmail.gaadiglow.in  Gmail sign-in callback
# EDIT if the domain is different
CLOUDFLARE_DOMAIN=gaadiglow.in
DEPLOYMENT_PREFIX=pay
# EDIT with the domain
BASE_PAYMENT_API_URL=https://pay-api.gaadiglow.in
# EDIT with the domain
BASE_CHECKOUT_URL=https://pay.gaadiglow.in
# EDIT with the domain
BASE_ADMIN_URL=https://pay-admin.gaadiglow.in

# The only websites allowed to show the checkout inside them (space separated).
# EDIT: put the app's real addresses here, including the Firebase ones.
CHECKOUT_FRAME_ANCESTORS=https://gaadiglow.in https://www.gaadiglow.in https://YOUR-PROJECT.web.app https://YOUR-PROJECT.firebaseapp.com

# --- Database (a single file; back it up daily) ---
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/youpi_pg.sqlite

# --- Secrets (setup.sh fills these) ---
# ADMIN_API_TOKEN is also the password for the merchant admin page. Keep it like a bank PIN.
ENCRYPTION_MASTER_KEY=__GENERATE__
JWT_SECRET=__GENERATE__
ADMIN_API_TOKEN=__GENERATE__
OBSERVER_API_TOKEN=__GENERATE__
ANDROID_ENROLLMENT_SECRET=__GENERATE__

# --- Payment timing (defaults from the project) ---
PAYMENT_ACTIVE_WINDOW_MS=300000
PAYMENT_PROCESSING_WINDOW_MS=30000
LATE_OBSERVATION_WINDOW_MS=1800000

# --- Gmail observer (optional but needed for the green "Server is working" state) ---
# Create these in Google Cloud Console: see docs/google_cloud_console_setup_guide.md in the gateway.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://pay-gmail.gaadiglow.in/oauth/callback
GMAIL_POLL_INTERVAL_MS=5000

# --- SMS observers ---
SMS_OBSERVER_POLL_INTERVAL_MS=3000
ANDROID_HEARTBEAT_TIMEOUT_MS=180000

# --- Webhooks to GaadiGlow (Cloud Function youpiWebhook) ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000

# --- Look ---
DEFAULT_APP_NAME="GaadiGlow"
DEFAULT_PRIMARY_COLOR="#1557FF"
# EDIT
DEFAULT_SUPPORT_EMAIL="support@gaadiglow.in"

# --- Local testing only: never turn these on for the real server ---
# YOUPI_MODE=localhost
# YOUPI_ALLOW_LOCALHOST_MODE=true
# YOUPI_ALLOW_PRIVATE_WEBHOOKS=true
# YOUPI_EXPOSE_DEV_OTP=true
